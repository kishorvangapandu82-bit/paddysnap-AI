# ============================================================
# PADDY GUARD AI — .gitignore
# ============================================================

# --- Dataset (too large for git) ---
dataset/
*.csv.bak

# --- Model Weights & Checkpoints (too large for git) ---
checkpoints/
*.pth
*.pt
*.onnx
*.tflite
*.pkl

# Explicitly track edge deployment INT8 models & deployment INT8 models (< 30 MB)
!edge_deployment/model/*.onnx
!deployment/onnx/*_int8.onnx

# --- Python Environment ---
venv/
.venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# --- Jupyter Notebooks (optional, add if needed) ---
.ipynb_checkpoints/

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Secrets & Environment Variables ---
.env
*.secret
secrets.yaml
secrets.json

# --- Temporary Files ---
*.tmp
*.log
temp/
tmp/

# --- Results ---
# Track all evaluation graphs, confusion matrices, and training curves


# --- Streamlit Cache ---
.streamlit/

# --- Edge Deployment local generated runs ---
edge_deployment/*.csv
